# Database
DATABASE_URL=mysql+pymysql://username:password@localhost/websocket_db

# Security
SECRET_KEY=your-secret-key-here

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True

# WebSocket
WS_MAX_CONNECTIONS=1000
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=20

# Session
SESSION_EXPIRE_MINUTES=60
SESSION_CLEANUP_INTERVAL=300

# User Status
USER_INACTIVE_THRESHOLD=300
USER_STATUS_CLEANUP_INTERVAL=60
USER_STATUS_UPDATE_INTERVAL=30 